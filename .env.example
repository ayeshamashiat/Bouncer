# Copy to .env and fill in. Never commit .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
THREAT_GRAPH=threat

# Investigator LLM (optional). If missing, the regex fallback is used.
# Any LiteLLM model string, e.g. gemini/gemini-2.0-flash or anthropic/claude-haiku-4-5-20251001
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

CORS_ORIGINS=http://localhost:5173
# Where the hook / MCP server reach the API
BOUNCER_API_URL=http://localhost:8000

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=true
